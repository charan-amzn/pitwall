# Pitwall configuration — copy to `.env` and fill in. Loaded automatically if
# python-dotenv is installed. Every value can also be a plain exported env var.
#
# NOTE: The coding agent (Claude Code CLI) runs INSIDE the MicroVM and calls
# Bedrock via the VM's execution role. The host process needs AWS credentials
# only to launch/terminate the MicroVM — no LLM keys on the host.

# ─── Model (inside the VM) ──────────────────────────────────────────────────
# Bedrock inference-profile id used by Claude Code inside the MicroVM. This is
# forwarded to the VM at ask time, so you can change it without rebuilding.
PITWALL_MODEL=us.anthropic.claude-opus-4-8

# ─── AWS ────────────────────────────────────────────────────────────────────
# Required — used to talk to lambda-microvms AND (transitively) to Bedrock
# inside the VM. Use one of the supported regions:
# us-east-1, us-east-2, us-west-2, ap-northeast-1, eu-west-1.
AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...           # if using temporary creds

# ─── MicroVM sandbox ────────────────────────────────────────────────────────
# The image is found automatically by name (default 'pitwall-lab'), so you
# normally set NOTHING here. Override only if you want to:
# PITWALL_MICROVM_IMAGE_NAME=pitwall-lab   # image to look up by name
# PITWALL_MICROVM_IMAGE_ARN=...            # or pin an exact ARN (skips lookup)

# The exec role is auto-derived from your account/region as
# arn:aws:iam::<account>:role/PitwallMicrovmExecRole (created by setup_aws.sh).
# It grants bedrock:InvokeModel* so Claude Code INSIDE the VM can call Bedrock
# without any static credentials in the VM. Override only for a custom name:
# PITWALL_MICROVM_EXEC_ROLE_ARN=arn:aws:iam::123456789012:role/PitwallMicrovmExecRole
# PITWALL_EXEC_ROLE_NAME=PitwallMicrovmExecRole

# How to drive the MicroVMs API: auto (default) tries boto3, then the AWS CLI.
# Force one if needed. The CLI path works even when your boto3 lacks the service.
# PITWALL_MICROVM_DRIVER=auto           # auto | boto3 | cli
# PITWALL_AWS_CLI=aws                    # path to the aws binary (if not on PATH)

# Optional MicroVM tuning (sane defaults shown):
# PITWALL_MICROVM_INGRESS=arn:aws:lambda:us-west-2:aws:network-connector:aws-network-connector:ALL_INGRESS
# PITWALL_MICROVM_EGRESS=arn:aws:lambda:us-west-2:aws:network-connector:aws-network-connector:INTERNET_EGRESS
# PITWALL_MICROVM_MAX_IDLE_S=900        # suspend after N seconds idle
# PITWALL_MICROVM_SUSPENDED_S=1800      # auto-terminate after N seconds suspended
# PITWALL_MICROVM_MAX_DURATION_S=14400  # hard cap on total VM lifetime (<= 28800)
# PITWALL_MICROVM_TOKEN_MINUTES=30      # auth-token expiry
# PITWALL_MICROVM_PORT=8080             # in-VM server port
# PITWALL_MICROVM_READY_TIMEOUT_S=180   # how long to wait for RUNNING
# PITWALL_MICROVM_REQUEST_TIMEOUT_S=600 # per-ask stream timeout (agents can be chatty)

# ─── Build-time (microvm_image/build_image.sh) ──────────────────────────────
# build_image.sh auto-creates and auto-names these (bucket, build role, exec
# role, base image) — you normally set NOTHING here. Override only to use your
# own names:
# PITWALL_BUILD_BUCKET=my-pitwall-build-bucket
# PITWALL_BUILD_ROLE_NAME=PitwallMicrovmBuildRole
# PITWALL_EXEC_ROLE_NAME=PitwallMicrovmExecRole
# PITWALL_BASE_IMAGE_ARN=arn:aws:lambda:us-west-2:aws:microvm-image:al2023-1
# PITWALL_IMAGE_NAME=pitwall-lab

# ─── Data (baked into the image at build time) ──────────────────────────────
# Source for the dataset: openf1 (real current-season data, default) or
# synthetic (deterministic simulated data, no network).
# PITWALL_DATA_SOURCE=openf1
# PITWALL_SEASON=2026                   # which season to fetch (openf1)
# PITWALL_OPENF1_GAP_S=0.4              # delay between OpenF1 calls (rate-limit friendly)
# PITWALL_REBUILD_DATA=1                # force a re-fetch even if data/ exists
